# runset for edge testing
 ; single token after semicolon = comment
   # indented hash line
[VERSION]
GOLDEN-0001 reports/v1 uniq_end dup_g
GOLDEN-0001 reports/v2 uniq_end
;GOLDEN-0002 reports/disabled uniq_end
GOLDEN-0003
[CHECK]
setup WNS
hold NVP TNS
[GROUP]
uniq_end $sta_mode/$corner_name/$sta_check.rpt
dup_g    a.rpt b.rpt
g_quoted    "quoted pattern with space.rpt"
[MODE]
func   functional   func.sdc
scan01 dc_shift
[MYSPEC]
foo bar baz
[CORNER]
000 000_TT TTT:0.8V:25C RCtyp
157 157_BC FFF:0.88V:-40C Cmin
[SCENARIO]
S1 setup func   000 -
S2 hold  scan01 000 157
S3 hold  scan01 000 - 999
